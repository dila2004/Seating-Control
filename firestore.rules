rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDocExists() {
      return signedIn() && exists(userPath());
    }

    function userDoc() {
      return get(userPath()).data;
    }

    function activeUser() {
      return userDocExists() && userDoc().status == 'ACTIVE';
    }

    function hasRole(roles) {
      return activeUser() && userDoc().role in roles;
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if hasRole(['ADMIN']);
      allow create, update, delete: if false;
    }

    match /employees/{employeeId} {
      allow read: if activeUser();
      allow write: if false;
    }

    match /platforms/{platformId} {
      allow read: if activeUser();
      allow write: if false;
    }

    match /seatings/{seatingId} {
      allow read: if activeUser();
      allow write: if false;
    }

    match /settings/{settingId} {
      allow read: if activeUser();
      allow write: if false;
    }

    match /seatingHistory/{historyId} {
      allow read: if hasRole(['PIC', 'TL', 'SPV', 'ADMIN']);
      allow write: if false;
    }

    match /auditLogs/{logId} {
      allow read: if hasRole(['PIC', 'TL', 'SPV', 'ADMIN']);
      allow write: if false;
    }

    match /seatingChangeRequests/{requestId} {
      allow read: if hasRole(['PIC', 'TL', 'SPV', 'ADMIN']);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
